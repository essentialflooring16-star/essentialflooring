---
// The client's own logo, rebuilt as a live-text lockup so it stays crisp at
// every size and on every ground. The original (WhatsApp, 17 Aug) is a JPG on
// baked-in anthracite: two planks above the E, ESSENTIAL fading cream to
// copper, FLOORING letterspaced in copper beneath. tone="dark" mirrors that
// original 1:1 for anthracite grounds (footer); tone="light" re-inks the same
// lockup for the white header, ink instead of cream, copper unchanged in
// spirit but darkened to the on-light role so it keeps its contrast.
interface Props {
  /** overall scale: header (compact) or footer (full, with the service line) */
  variant?: 'header' | 'footer';
  /** the ground it sits on */
  tone?: 'dark' | 'light';
}
const { variant = 'header', tone = 'dark' } = Astro.props;
const compact = variant === 'header';
const onDark = tone === 'dark';
const plankA = onDark ? 'var(--ef-fg-on-dark)' : 'var(--ef-ink-900)';
const plankB = onDark ? 'var(--ef-accent-on-dark)' : 'var(--ef-accent-display)';
---

<span class={`inline-block leading-none select-none ${compact ? '' : 'pb-0.5'}`}>
  <svg
    width={compact ? 27 : 34}
    height={compact ? 10 : 13}
    viewBox="0 0 34 13"
    fill="none"
    aria-hidden="true"
    class={`block ${compact ? 'mb-[-1px]' : 'mb-[-2px]'}`}
  >
    <g transform="rotate(-19 17 6.5)">
      <rect x="2" y="3.1" width="24" height="3.1" fill={plankA} />
      <rect x="8" y="7.4" width="24" height="3.1" fill={plankB} />
    </g>
  </svg>
  <span
    class={`block font-brand font-extrabold uppercase tracking-[-0.01em] text-transparent bg-clip-text bg-gradient-to-r from-55% ${onDark ? 'from-fg-on-dark to-accent-on-dark' : 'from-fg to-[#96632F]'} ${compact ? 'text-[21px]' : 'text-[26px]'}`}
  >
    Essential
  </span>
  <span
    class={`mt-[3px] flex items-center gap-2 font-semibold uppercase ${onDark ? 'text-accent-on-dark' : 'text-accent-display'} ${compact ? 'text-[9.5px] tracking-[0.34em]' : 'text-[11px] tracking-[0.4em]'}`}
  >
    <span class={`h-px flex-1 ${onDark ? 'bg-accent-on-dark/60' : 'bg-accent-display/50'}`} aria-hidden="true"></span>
    Flooring
    <span class={`h-px flex-1 ${onDark ? 'bg-accent-on-dark/60' : 'bg-accent-display/50'}`} aria-hidden="true"></span>
  </span>
  {!compact && (
    <span class="mt-2 block text-[8px] leading-[1.6] tracking-[0.07em] uppercase text-fg-on-dark/70 font-semibold">
      <span class="whitespace-nowrap">
        LVP, Laminate &amp; Vinyl
        <span class="text-fg-on-dark/40" aria-hidden="true">&#8226;</span>
      </span>
      {' '}<span class="whitespace-nowrap">Hardwood Refinishing</span>
    </span>
  )}
</span>
