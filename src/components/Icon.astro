---
// The site's own icon set, drawn for this client rather than pulled from a
// library. Glyphs are 2.1px round strokes in the current text colour, so the
// same icon works on paper and on the green. There used to be a small copper
// chip behind every glyph, a plank at the logo's angle; Artiom read it as a
// stray line next to each icon and asked for it to go, so it went.
interface Props {
  name:
    | 'refinish'
    | 'plank'
    | 'stairs'
    | 'layers'
    | 'carpet'
    | 'ruler'
    | 'shield'
    | 'clock'
    | 'pin'
    | 'check'
    | 'hammer'
    | 'sparkle';
  /** px, default 28 */
  size?: number;
  class?: string;
}
const { name, size = 28, class: cls = '' } = Astro.props;

// Every path lives on a 28x28 grid. The chip sits behind, offset up-left.
const glyphs: Record<string, string> = {
  // two boards with a sparkle over them: a floor brought back to a shine
  refinish: `
    <path d="M4 19.5h20M4 24h20" />
    <path d="M9.5 19.5V24M17 19.5V24" />
    <path d="M17.5 4.5c.5 3 1.7 4.4 5.5 5.5-3.8 1.1-5 2.5-5.5 5.5-.5-3-1.7-4.4-5.5-5.5 3.8-1.1 5-2.5 5.5-5.5z" />`,
  // a tile of plank flooring: three courses inside a frame, joints staggered
  plank: `
    <rect x="4" y="5.5" width="20" height="17" rx="1.5" />
    <path d="M4 11.2h20M4 16.8h20" />
    <path d="M11 5.5v5.7M17 11.2v5.6M10 16.8v5.7" />`,
  // a closed staircase silhouette, four treads
  stairs: `
    <path d="M4 24h5v-5h5v-5h5v-5h5v15z" />`,
  // laminate: boards in perspective
  layers: `
    <path d="M4.5 18.5l10 5 9-4.5" />
    <path d="M4.5 14l10 5 9-4.5" />
    <path d="M4.5 9.5l10 5 9-4.5-10-4.5z" />`,
  // a carpet roll from the side, the last turn unrolling to the right
  carpet: `
    <circle cx="9" cy="17" r="5" />
    <circle cx="9" cy="17" r="1.4" fill="currentColor" stroke="none" />
    <path d="M9 12h10.5a4.5 4.5 0 0 1 4.5 4.5V22H14" />`,
  ruler: `
    <rect x="4.5" y="11" width="19" height="7" rx="1" />
    <path d="M9 11v3M13.5 11v4.5M18 11v3M22.5 11v4.5" transform="translate(-1.5 0)" />`,
  shield: `
    <path d="M14 4.5l7.5 3v6c0 5-3.1 8.4-7.5 10-4.4-1.6-7.5-5-7.5-10v-6z" />
    <path d="M10.8 14l2.3 2.4 4.4-4.8" />`,
  clock: `
    <circle cx="14" cy="14.5" r="8" />
    <path d="M14 9.8v4.7l3.4 2" />`,
  pin: `
    <path d="M14 25s-7.5-6.6-7.5-12a7.5 7.5 0 0 1 15 0c0 5.4-7.5 12-7.5 12z" />
    <circle cx="14" cy="12.8" r="2.6" />`,
  check: `
    <path d="M5.5 15l6 6L23 8.5" />`,
  hammer: `
    <path d="M7 8.5l4-4 8 8-4 4z" />
    <path d="M13.5 15L6 22.5a1.8 1.8 0 0 1-2.5-2.5L11 12.5" />
    <path d="M17 6.5l4.5 4.5" />`,
  sparkle: `
    <path d="M14 4.5c.8 4.6 2.4 6.6 9.5 9.5-7.1 2.9-8.7 4.9-9.5 9.5-.8-4.6-2.4-6.6-9.5-9.5 7.1-2.9 8.7-4.9 9.5-9.5z" />`,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  stroke="currentColor"
  stroke-width="2.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
>
  <g set:html={glyphs[name]} />
</svg>
