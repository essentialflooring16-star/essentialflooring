---
// Real job site videos, muted and looping. Kept tiny (under 0.5MB
// each) and lazy: they only start once scrolled into view.
const videos = [
  { src: '/videos/work-01.mp4', label: 'Plank install in progress' },
  { src: '/videos/work-02.mp4', label: 'On site, mid install' },
  { src: '/videos/work-03.mp4', label: 'Finishing touches' },
];
---

<section class="py-16 sm:py-20 bg-sand/60 overflow-hidden">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-end justify-between gap-6 mb-9">
      <div class="reveal">
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-oak-deep mb-3">Straight from the job site</p>
        <h2 class="font-display font-semibold text-3xl sm:text-4xl text-ink tracking-tight">
          No stock footage. <span class="accent-italic">Our</span> hands, our work.
        </h2>
      </div>
    </div>
    <div class="grid sm:grid-cols-3 gap-4 sm:gap-5">
      {videos.map((v, i) => (
        <figure class={`reveal-scale relative rounded-2xl overflow-hidden shadow-card aspect-[3/4] sm:aspect-[4/5] ${i === 1 ? 'sm:translate-y-6' : ''}`} style={`transition-delay:${i * 70}ms`}>
          <video
            class="h-full w-full object-cover"
            muted
            loop
            playsinline
            preload="none"
            data-lazy-video={v.src}
            aria-label={v.label}
          ></video>
          <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/65 to-transparent px-4 pt-8 pb-3.5 text-white text-[13.5px] font-medium">
            {v.label}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  // Start/stop videos as they enter and leave the viewport.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (vids.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (!v.src) v.src = v.dataset.lazyVideo!;
            if (!reduced) v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    vids.forEach((v) => io.observe(v));
  }
</script>
