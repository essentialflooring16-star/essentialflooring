---
import { SITE, SERVICES, CORE_CITIES } from '../data/site';
import BrandLogo from './BrandLogo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-surface-dark text-fg-on-dark/80">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" aria-label="Essential Flooring, home" class="inline-block"><BrandLogo variant="footer" /></a>
      <p class="mt-3 text-[15px] leading-relaxed">
        Licensed flooring contractor serving the greater Sacramento area.
        Hardwood refinishing, LVP, laminate and carpet, done right and on time.
      </p>
      <p class="mt-4 text-[14px] text-fg-on-dark/60">Licensed &amp; Insured, {SITE.license}</p>
      <div class="mt-4 flex items-center gap-4">
        <a
          href={SITE.instagram}
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 text-[14px] text-fg-on-dark/70 hover:text-accent-on-dark transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
          </svg>
          Instagram
        </a>
        <a
          href={SITE.facebook}
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 text-[14px] text-fg-on-dark/70 hover:text-accent-on-dark transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M14 8h2.5V4.5H14A4.5 4.5 0 0 0 9.5 9v2.5H7V15h2.5v5.5H13V15h2.5l.5-3.5h-3V9c0-.6.4-1 1-1Z" stroke-linejoin="round" />
          </svg>
          Facebook
        </a>
      </div>
    </div>

    <nav aria-label="Services footer">
      <p class="text-[13px] uppercase tracking-[0.16em] text-fg-on-dark/50 mb-4">Services</p>
      <ul class="space-y-2.5 text-[15px]">
        {SERVICES.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`} class="hover:text-accent-on-dark transition-colors">{s.name}</a>
          </li>
        ))}
        <li><a href="/portfolio/" class="hover:text-accent-on-dark transition-colors">Our Work</a></li>
        <li><a href="/blog/" class="hover:text-accent-on-dark transition-colors">Blog</a></li>
      </ul>
    </nav>

    <nav aria-label="Service areas footer">
      <p class="text-[13px] uppercase tracking-[0.16em] text-fg-on-dark/50 mb-4">Service Areas</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-[15px]">
        {CORE_CITIES.slice(0, 12).map((c) => (
          <li>
            <a href={`/service-areas/${c.slug}/`} class="hover:text-accent-on-dark transition-colors">{c.city}</a>
          </li>
        ))}
      </ul>
      <a href="/service-areas/" class="inline-block mt-3 text-[14px] text-accent-on-dark hover:underline">
        All service areas
      </a>
    </nav>

    <div>
      <p class="text-[13px] uppercase tracking-[0.16em] text-fg-on-dark/50 mb-4">Contact</p>
      <ul class="space-y-3 text-[15px]">
        <li>
          <a href={SITE.phoneHref} class="font-semibold text-fg-on-dark hover:text-accent-on-dark transition-colors">
            {SITE.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-accent-on-dark transition-colors break-all">
            {SITE.email}
          </a>
        </li>
        <li>Sacramento, California</li>
        <li class="text-fg-on-dark/60">Mon to Sat, 7 AM to 7 PM</li>
      </ul>
      <a
        href="/contact/"
        class="mt-5 inline-flex items-center rounded-full bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold text-[15px] px-5 py-2.5 transition-colors"
      >
        Get a Free Estimate
      </a>
    </div>
  </div>

  <div class="border-t border-hairline-on-dark/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-[13px] text-fg-on-dark/50">
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/privacy-policy/" class="hover:text-fg-on-dark/80 transition-colors">Privacy Policy</a>
        <a href="/sitemap-index.xml" class="hover:text-fg-on-dark/80 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
