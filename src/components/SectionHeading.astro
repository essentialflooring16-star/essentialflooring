---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, text, align = 'left', light = false } = Astro.props;
---

<div class={`reveal max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''}`}>
  {eyebrow && (
    <p class={`eyebrow-pill ${light ? 'on-dark' : 'on-light'} mb-4`}>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
      </svg>
      {eyebrow}
    </p>
  )}
  <h2 class={`font-display font-semibold text-3xl sm:text-4xl leading-[1.12] tracking-tight ${light ? 'text-cream' : 'text-ink'}`}>
    {title}
  </h2>
  {text && (
    <p class={`mt-4 text-[17px] leading-relaxed ${light ? 'text-cream/75' : 'text-coffee'}`}>
      {text}
    </p>
  )}
</div>
