---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, text, align = 'left', light = false } = Astro.props;
---

<div class={`reveal max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''}`}>
  {eyebrow && (
    <p class={`eyebrow ${light ? 'on-dark' : 'on-light'} mb-5`}>{eyebrow}</p>
  )}
  <h2 class={`font-display font-semibold text-3xl sm:text-4xl leading-[1.12] tracking-tight ${light ? 'text-fg-on-dark' : 'text-fg'}`}>
    {title}
  </h2>
  {text && (
    <p class={`mt-4 text-[17px] leading-relaxed ${light ? 'text-fg-on-dark/75' : 'text-fg-muted'}`}>
      {text}
    </p>
  )}
</div>
