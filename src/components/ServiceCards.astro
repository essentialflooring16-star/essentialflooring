---
// Services as framed pictures on the green: each card is a paper mat around a
// real project photograph, with the caption set beneath the picture the way a
// gallery labels a frame — icon from the site's own set, serif title, one
// line of text. The mat is what makes the phone photographs read as curated
// work instead of screenshots.
import { Image } from 'astro:assets';
import { SERVICES } from '../data/site';
import { photoImage, photoById } from '../lib/photos';
import Icon from './Icon.astro';

const icons: Record<string, 'refinish' | 'plank' | 'stairs' | 'layers' | 'carpet'> = {
  'hardwood-floor-refinishing': 'refinish',
  'lvp-vinyl-plank-flooring': 'plank',
  'stairs-installation-refinishing': 'stairs',
  'laminate-flooring': 'layers',
  'carpet-installation': 'carpet',
};
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-5 sm:gap-6">
  {SERVICES.map((s, i) => {
    const big = i === 0;
    const spans = [
      'lg:col-span-3 lg:row-span-2 sm:col-span-2',
      'lg:col-span-3',
      'lg:col-span-3',
      'lg:col-span-3',
      'lg:col-span-3',
    ];
    return (
      <a
        href={`/services/${s.slug}/`}
        class={`m-rise card-lift group flex flex-col rounded-card bg-surface-raised p-2.5 pb-0 shadow-card ${spans[i]}`}
        style={`--i:${i}`}
      >
        <span class={`relative block overflow-hidden rounded-media ${big ? 'aspect-[4/4.4] sm:aspect-[16/12] lg:aspect-auto lg:flex-1 lg:min-h-0' : 'aspect-[16/9]'}`}>
          <Image
            src={photoImage(s.image)}
            alt={'imageAlt' in s ? s.imageAlt : photoById(s.image).alt}
            widths={[480, 760, 1100]}
            sizes={big ? '(min-width:1024px) 50vw, 100vw' : '(min-width:1024px) 50vw, (min-width:640px) 50vw, 100vw'}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
            format="webp"
            quality={68}
          />
          <span
            class="absolute top-3 right-3 grid place-items-center size-9 rounded-btn bg-scrim-media/40 backdrop-blur-[2px] text-fg-on-media opacity-0 -translate-y-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0"
            aria-hidden="true"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>

        <span class="flex items-start gap-3.5 px-2.5 sm:px-3 py-4">
          <Icon name={icons[s.slug] ?? 'plank'} size={30} class="shrink-0 mt-0.5 text-fg" />
          <span class="min-w-0">
            <span class={`block font-display font-medium text-fg leading-snug ${big ? 'text-[22px] sm:text-[25px]' : 'text-[19px] sm:text-[21px]'}`}>
              {s.name}
            </span>
            <span class={`mt-1.5 block text-fg-muted text-[13.5px] leading-relaxed ${big ? 'max-w-md' : 'hidden xl:block'}`}>
              {s.short}
            </span>
          </span>
        </span>
      </a>
    );
  })}
</div>
