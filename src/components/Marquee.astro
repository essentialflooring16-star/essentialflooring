---
// Scrolling ribbon. Items repeat twice for a seamless CSS loop; the second
// copy is aria-hidden so screen readers hear the list once.
interface Props {
  items: readonly string[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<div
  class={`marquee overflow-hidden py-4 border-y select-none ${
    dark ? 'bg-ink border-cream/10 text-cream/85' : 'bg-sand/70 border-line text-bark'
  }`}
>
  <div class="marquee-track items-center">
    {[false, true].map((hidden) => (
      <ul class="flex items-center shrink-0" aria-hidden={hidden ? 'true' : undefined}>
        {items.map((item) => (
          <li class="flex items-center shrink-0">
            <span class="font-display text-[17px] tracking-wide whitespace-nowrap px-5">{item}</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill={dark ? '#d9a86c' : '#b5773a'}
              aria-hidden="true"
              class="shrink-0"
            >
              <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
            </svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
