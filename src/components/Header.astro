---
import { SITE } from '../data/site';
import BrandLogo from './BrandLogo.astro';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/portfolio/', label: 'Our Work' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/faq/', label: 'FAQ' },
];

// Compare with trailing slashes stripped from both sides: the nav hrefs end in
// '/' to match vercel.json trailingSlash, the pathname may or may not.
const strip = (v: string) => v.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const isActive = (href: string) => {
  const h = strip(href);
  return path === h || (h !== '/' && path.startsWith(h + '/'));
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-surface/92 backdrop-blur-md border-b border-hairline transition-shadow"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-[72px]">
    <a href="/" class="block group" aria-label="Essential Flooring, home">
      <BrandLogo variant="header" tone="light" />
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class="nav-link text-[14.5px] font-medium text-fg-muted hover:text-fg transition-colors"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="arrow-link hidden sm:inline-flex items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold text-[15px] px-5 py-2.5 transition-colors shadow-card"
      >
        Free Estimate
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden grid place-items-center size-11 rounded-btn border border-hairline text-fg"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="menu-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-hairline bg-surface">
    <nav class="mx-auto max-w-6xl px-4 sm:px-6 py-4 flex flex-col" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="py-3 text-[17px] font-medium text-fg border-b border-hairline last:border-0"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="mt-4 inline-flex justify-center items-center rounded-btn bg-accent text-fg-on-accent font-semibold px-5 py-3"
      >
        Get a Free Estimate
      </a>
      <a href={SITE.phoneHref} class="mt-3 text-center text-fg font-medium py-2">
        Call {SITE.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle?.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  };
  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? true);
  });
  // Escape closes the mobile nav and returns focus to the toggle.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu || menu.classList.contains('hidden')) return;
    setOpen(false);
    toggle?.focus();
  });
</script>
