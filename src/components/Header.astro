---
import { SITE } from '../data/site';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/portfolio/', label: 'Our Work' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/faq/', label: 'FAQ' },
];

// Compare with trailing slashes stripped from both sides: the nav hrefs end in
// '/' to match vercel.json trailingSlash, the pathname may or may not.
const strip = (v: string) => v.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const isActive = (href: string) => {
  const h = strip(href);
  return path === h || (h !== '/' && path.startsWith(h + '/'));
};
---

<div class="bg-ink text-cream/90 text-[13px]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between gap-4 h-9">
    <p class="hidden sm:block tracking-wide">
      Licensed &amp; Insured <span class="text-oak-soft font-medium">{SITE.license}</span>
    </p>
    <div class="flex items-center gap-5">
      <a href={SITE.phoneHref} class="hover:text-oak-soft transition-colors font-medium">
        {SITE.phone}
      </a>
      <span class="hidden sm:inline text-cream/40">|</span>
      <p class="hidden sm:block">Free estimates, Sacramento CA</p>
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-line transition-shadow"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-[72px]">
    <a href="/" class="flex items-center gap-3 group" aria-label="Essential Flooring, home">
      <span
        class="grid place-items-center size-10 rounded-[10px] bg-ink text-cream group-hover:bg-oak transition-colors"
        aria-hidden="true"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 9.5 12 3l9 6.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M5 11v9h14v-9" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M9 20v-4h6v4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="leading-none">
        <span class="block font-display font-semibold text-[19px] tracking-tight text-ink">Essential Flooring</span>
        <span class="block text-[11px] uppercase tracking-[0.18em] text-coffee mt-1">Sacramento, California</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class="nav-link text-[15px] font-medium text-bark hover:text-ink transition-colors"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="hidden sm:inline-flex items-center gap-2 rounded-full bg-oak hover:bg-oak-deep text-white font-semibold text-[15px] px-5 py-2.5 transition-colors shadow-card"
      >
        Free Estimate
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden grid place-items-center size-11 rounded-lg border border-line text-ink"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="menu-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-cream">
    <nav class="mx-auto max-w-6xl px-4 sm:px-6 py-4 flex flex-col" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="py-3 text-[17px] font-medium text-bark border-b border-line/60 last:border-0"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="mt-4 inline-flex justify-center items-center rounded-full bg-oak text-white font-semibold px-5 py-3"
      >
        Get a Free Estimate
      </a>
      <a href={SITE.phoneHref} class="mt-3 text-center text-bark font-medium py-2">
        Call {SITE.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  });
</script>
