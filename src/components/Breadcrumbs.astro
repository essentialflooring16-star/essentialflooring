---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  light?: boolean;
}
const { crumbs, light = false } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.label,
      ...(c.href ? { item: new URL(c.href.endsWith('/') ? c.href : c.href + '/', Astro.site).href } : {}),
    })),
  ],
};
---

<nav aria-label="Breadcrumb" class={`text-[13px] ${light ? 'text-fg-on-dark/70' : 'text-fg-muted'}`}>
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class={light ? 'hover:text-accent-on-dark transition-colors' : 'hover:text-accent-on-light transition-colors'}>Home</a></li>
    {crumbs.map((c) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true" class={light ? 'text-fg-on-dark/40' : 'text-fg-subtle'}>/</span>
        {c.href ? (
          <a href={c.href.endsWith('/') ? c.href : c.href + '/'} class={light ? 'hover:text-accent-on-dark transition-colors' : 'hover:text-accent-on-light transition-colors'}>{c.label}</a>
        ) : (
          <span aria-current="page" class={`font-medium ${light ? 'text-fg-on-dark' : 'text-fg-body'}`}>{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
