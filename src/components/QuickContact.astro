---
// Floating quick-contact button, bottom right on every page.
import { SITE } from '../data/site';
const wa = 'https://wa.me/19164251361';
---

<div id="quick-contact" class="fixed bottom-5 right-5 z-[70] flex flex-col items-end gap-3">
  <div
    id="qc-menu"
    class="hidden flex-col items-stretch gap-2 min-w-[210px]"
  >
    <a
      href={SITE.phoneHref}
      class="flex items-center gap-3 rounded-card bg-surface-raised border border-hairline shadow-lift px-4 py-3 text-[15px] font-semibold text-fg hover:border-accent transition-colors"
    >
      <span class="grid place-items-center size-9 rounded-btn bg-control-dark text-fg-on-dark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      Call now
    </a>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="flex items-center gap-3 rounded-card bg-surface-raised border border-hairline shadow-lift px-4 py-3 text-[15px] font-semibold text-fg hover:border-accent transition-colors"
    >
      <span class="grid place-items-center size-9 rounded-btn bg-[#25D366] text-white" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3 0-.2 0-.3-.1-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.9.9-1.2 2.1-.6 3.5.9 2 2.5 3.8 4.5 4.9 2.3 1.3 3.2 1.1 3.9 1 .8-.1 1.5-.6 1.7-1.2.2-.6.2-1.2.1-1.3 0-.2-.2-.3-.6-.6Z" />
        </svg>
      </span>
      WhatsApp
    </a>
    <a
      href="/contact/"
      class="flex items-center gap-3 rounded-card bg-accent text-fg-on-accent shadow-lift px-4 py-3 text-[15px] font-semibold hover:bg-accent-hover transition-colors"
    >
      <span class="grid place-items-center size-9 rounded-btn bg-fg-on-accent/20" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <path d="M4 5h16v12H8l-4 4V5Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      Free estimate
    </a>
  </div>

  <button
    id="qc-toggle"
    type="button"
    class="relative grid place-items-center size-15 w-[60px] h-[60px] rounded-full bg-accent text-fg-on-accent shadow-lift hover:bg-accent-hover transition-colors cursor-pointer"
    aria-expanded="false"
    aria-controls="qc-menu"
    aria-label="Quick contact options"
  >
    <span class="absolute inset-0 rounded-full bg-accent animate-pulse-ring motion-reduce:hidden" aria-hidden="true"></span>
    <svg class="qc-open relative" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg class="qc-close relative hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
    </svg>
  </button>
</div>

<script>
  const toggle = document.getElementById('qc-toggle');
  const menu = document.getElementById('qc-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menu?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.qc-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.qc-close')?.classList.toggle('hidden', !open);
  });
  const close = () => {
    if (!menu || menu.classList.contains('hidden')) return;
    menu.classList.add('hidden');
    menu.classList.remove('flex');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.querySelector('.qc-open')?.classList.remove('hidden');
    toggle?.querySelector('.qc-close')?.classList.add('hidden');
  };
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#quick-contact')) close();
  });
  // Escape closes it and hands focus back to the button that opened it.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu || menu.classList.contains('hidden')) return;
    close();
    toggle?.focus();
  });
</script>
