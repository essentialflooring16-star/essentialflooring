---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPublishedPosts, postDate } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<Base
  title="Flooring Blog | Tips from Essential Flooring, Sacramento"
  description="Flooring advice, project stories and floor care tips from Essential Flooring, a licensed flooring contractor in Sacramento, CA."
>
  <section class="pt-10 pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'Blog' }]} />
      <div class="mt-8 mb-12 max-w-2xl">
        <p class="eyebrow-pill on-light mb-4">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
          </svg>
          From the job site
        </p>
        <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-fg">
          Floor talk
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-fg-muted">
          Project stories, honest advice and floor care tips from Essential Flooring
          in Sacramento.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="reveal rounded-3xl border border-hairline bg-surface-raised shadow-card p-10 sm:p-14 text-center max-w-2xl mx-auto">
          <h2 class="font-display font-semibold text-2xl text-fg">First stories coming soon</h2>
          <p class="mt-3 text-[16px] leading-relaxed text-fg-muted">
            The first articles are being written. In the meantime, browse the finished
            work or ask us anything directly.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a href="/portfolio/" class="inline-flex items-center rounded-full bg-control-dark hover:bg-control-dark-hover text-fg-on-dark font-semibold px-6 py-3 transition-colors">
              See our work
            </a>
            <a href="/contact/" class="inline-flex items-center rounded-full border border-hairline hover:border-accent text-fg font-semibold px-6 py-3 transition-colors">
              Ask a question
            </a>
          </div>
        </div>
      ) : (
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, i) => (
            <li class="reveal-scale" style={`transition-delay:${(i % 3) * 60}ms`}>
              <a
                href={`/blog/${post.slug}/`}
                class="group flex flex-col h-full rounded-2xl overflow-hidden bg-surface-raised border border-hairline shadow-card hover:shadow-lift transition-shadow"
              >
                {post.cover_url ? (
                  <span class="block aspect-[16/10] overflow-hidden">
                    <img
                      src={post.cover_url}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                    />
                  </span>
                ) : (
                  <span class="block aspect-[16/10] bg-surface-sunken" aria-hidden="true"></span>
                )}
                <span class="flex flex-col flex-1 p-6">
                  <span class="text-[13px] text-fg-muted">{postDate(post)}</span>
                  <h2 class="mt-2 font-display font-semibold text-xl leading-snug text-fg group-hover:text-accent-on-light transition-colors">
                    {post.title}
                  </h2>
                  {post.excerpt && (
                    <span class="mt-2.5 text-[14.5px] leading-relaxed text-fg-muted line-clamp-3">
                      {post.excerpt}
                    </span>
                  )}
                  <span class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-semibold text-accent-on-light">
                    Read more
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                      <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CtaBand />
</Base>
