---
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';

import { getPublishedPosts, postDate, type Post } from '../../lib/blog';
import { getContent } from '../../lib/content';

const c = await getContent();

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const postUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const readingMinutes = Math.max(1, Math.ceil(post.content.replace(/<[^>]*>/g, ' ').split(/\s+/).length / 220));

// Post bodies come from the admin panel and are baked into static HTML, so an
// injected <script> would be served to every visitor. Sanitize at build time.
const sanitized = sanitizeHtml(marked.parse(post.content, { async: false }) as string, {
  allowedTags: [
    'h2', 'h3', 'h4', 'p', 'a', 'ul', 'ol', 'li', 'blockquote',
    'strong', 'em', 'code', 'pre', 'br', 'hr', 'img', 'figure', 'figcaption',
    'table', 'thead', 'tbody', 'tr', 'th', 'td',
  ],
  allowedAttributes: {
    a: ['href', 'title'],
    img: ['src', 'alt', 'title', 'width', 'height', 'loading', 'decoding'],
  },
  allowedSchemes: ['http', 'https', 'mailto', 'tel'],
  transformTags: {
    // Anything the client links out to opens safely.
    a: (tagName, attribs) => {
      const href = attribs.href ?? '';
      const external = /^https?:\/\//i.test(href) && !href.includes('essentialflooringinc.com');
      return {
        tagName,
        attribs: external ? { ...attribs, target: '_blank', rel: 'noopener nofollow' } : attribs,
      };
    },
    img: (tagName, attribs) => ({
      tagName,
      attribs: { ...attribs, loading: 'lazy', decoding: 'async' },
    }),
  },
});

const sections: { id: string; label: string }[] = [];
const html = sanitized.replace(/<h2>([\s\S]*?)<\/h2>/g, (_, heading: string) => {
  const id = `section-${sections.length + 1}`;
  // The label is already sanitized HTML; remove formatting but keep entities.
  sections.push({ id, label: heading.replace(/<[^>]*>/g, '') });
  return `<h2 id="${id}" style="scroll-margin-top:110px">${heading}</h2>`;
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  url: postUrl,
  mainEntityOfPage: postUrl,
  isPartOf: { '@id': `${c.site.domain}/#website` },
  inLanguage: 'en-US',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.created_at,
  dateModified: post.updated_at,
  author: {
    '@type': 'Organization',
    '@id': `${c.site.domain}/#business`,
    name: c.site.name,
    url: `${c.site.domain}/`,
  },
  publisher: { '@id': `${c.site.domain}/#business` },
  ...(post.cover_url ? { image: new URL(post.cover_url, Astro.site).href } : {}),
};
---

<Base
  title={`${post.title} | Essential Flooring`}
  description={post.excerpt || `${post.title}. Flooring tips and project stories from Essential Flooring, Sacramento CA.`}
  ogImage={post.cover_url ?? undefined}
  ogImageAlt={post.cover_alt}
  ogType="article"
  schema={[schema]}
>
  <article class="pt-10 pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'Blog', href: '/blog/' }, { label: post.title }]} />
      <header class="mt-8">
        <p class="eyebrow on-light mb-4">The flooring guide</p>
        <h1 class="font-display font-semibold text-4xl sm:text-[48px] leading-[1.1] tracking-tight text-fg text-balance">
          {post.title}
        </h1>
        <p class="mt-5 text-[14px] text-fg-muted">
          By <a href="/about/" rel="author" class="text-accent-on-light underline underline-offset-4">{c.site.name}</a>
          &middot; <time datetime={post.created_at}>{postDate(post)}</time>
          &middot; {readingMinutes} min read
        </p>
        {post.excerpt && <p class="mt-5 text-[18px] sm:text-[20px] leading-relaxed text-fg-muted">{post.excerpt}</p>}
      </header>

      {post.cover_url && (
        <img
          src={post.cover_url}
          alt={post.cover_alt || `Cover image for ${post.title}`}
          class="mt-8 w-full aspect-[16/9] object-cover rounded-media shadow-lift"
          decoding="async"
        />
      )}

      {sections.length > 2 && (
        <nav aria-label="In this guide" class="mt-8 rounded-card border border-hairline bg-surface-sunken/70 p-6 sm:p-7">
          <p class="font-semibold text-fg">In this guide</p>
          <ol class="mt-4 grid sm:grid-cols-2 gap-x-6 gap-y-3 list-decimal pl-5 text-[14px] leading-snug text-fg-muted marker:text-accent-on-light">
            {sections.map((section) => (
              <li><a href={`#${section.id}`} class="hover:text-accent-on-light underline underline-offset-4 decoration-hairline" set:html={section.label} /></li>
            ))}
          </ol>
        </nav>
      )}

      <div
        class="mt-10 max-w-none text-[17px] leading-relaxed text-fg-body
          [&_h2]:font-display [&_h2]:font-semibold [&_h2]:text-2xl [&_h2]:text-fg [&_h2]:mt-10 [&_h2]:mb-3
          [&_h3]:font-display [&_h3]:font-semibold [&_h3]:text-xl [&_h3]:text-fg [&_h3]:mt-8 [&_h3]:mb-2
          [&_p]:mb-5 [&_a]:text-accent-on-light [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-2
          [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-5 [&_li]:mb-1.5
          [&_img]:rounded-card [&_img]:shadow-card [&_img]:my-6
          [&_blockquote]:border-l-4 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-fg-muted"
        set:html={html}
      />

      <footer class="mt-12 rounded-card bg-surface-sunken/70 border border-hairline p-7 text-center">
        <p class="font-display font-semibold text-xl text-fg">
          Thinking about your own floors?
        </p>
        <p class="mt-2 text-[15px] text-fg-muted">
          Estimates are free and honest. Call {c.site.phone} or send us your project.
        </p>
        <a
          href="/contact/"
          class="mt-4 inline-flex items-center rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-6 py-3 transition-colors"
        >
          Get a free estimate
        </a>
      </footer>
    </div>
  </article>

  <CtaBand />
</Base>
