---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { getReviews, ratingSummary, reviewDate } from '../lib/reviews';

// Reviews are pasted into the admin cabinet and fetched at build time. The
// deploy hook rebuilds the site when the client saves, so they ship as static
// HTML. src/data/reviews.json remains the fallback before Supabase is wired.
const reviews = await getReviews();
const summary = ratingSummary(reviews);

// AggregateRating is only emitted when real reviews exist. Publishing a rating
// with nothing behind it would be a fabricated claim.
const schema = summary
  ? [{
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${SITE.domain}/#business`,
      name: SITE.legalName,
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: summary.average,
        reviewCount: summary.count,
        bestRating: 5,
        worstRating: 1,
      },
      review: reviews.slice(0, 10).map((r) => ({
        '@type': 'Review',
        author: { '@type': 'Person', name: r.author },
        reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 },
        reviewBody: r.text,
        ...(r.date ? { datePublished: r.date } : {}),
      })),
    }]
  : [];
---

<Base
  title="Reviews | Essential Flooring, Sacramento CA"
  description="Essential Flooring reviews and ratings on Google. Licensed Sacramento flooring contractor for hardwood refinishing, LVP, laminate and carpet installation."
  schema={schema}
>
  <section class="pt-10 pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'Reviews' }]} />
      <div class="mt-8 max-w-2xl">
        <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-fg">
          What our clients say
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-fg-muted">
          We would rather let the work and the people we worked for speak for us.
          These reviews come from our Google Business profile.
        </p>
        {summary && (
          <p class="mt-6 inline-flex items-center gap-3 rounded-btn border border-hairline bg-surface-raised px-4 py-2.5">
            <span class="flex items-center gap-1 text-accent-display" aria-hidden="true">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill={i < Math.round(summary.average) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6">
                  <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
                </svg>
              ))}
            </span>
            <span class="text-[15px] font-semibold text-fg">{summary.average.toFixed(1)}</span>
            <span class="text-[14px] text-fg-muted">
              from {summary.count} {summary.count === 1 ? 'review' : 'reviews'}
            </span>
          </p>
        )}
      </div>

      {reviews.length > 0 ? (
        <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reviews.map((r) => (
            <li class="reveal rounded-card bg-surface-raised border border-hairline p-7 shadow-card flex flex-col">
              <div class="flex items-center gap-1 text-accent-display">
                <span class="sr-only">Rated {r.rating} out of 5 stars</span>
                {Array.from({ length: r.rating }).map(() => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
                  </svg>
                ))}
              </div>
              <p class="mt-4 text-[15px] leading-relaxed text-fg-body flex-1">{r.text}</p>
              <p class="mt-5 font-semibold text-[15px] text-fg">
                {r.author}
                {r.city && <span class="font-normal text-fg-muted"> &middot; {r.city}</span>}
              </p>
              {reviewDate(r) && (
                <p class="mt-1 text-[13px] text-fg-muted">{reviewDate(r)}</p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <div class="reveal mt-12 rounded-card border border-hairline bg-surface-raised shadow-card p-10 sm:p-14 text-center max-w-2xl mx-auto">
          <div class="inline-flex items-center justify-center size-14 rounded-btn bg-accent-wash text-accent-on-light" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M21 11.5a8.5 8.5 0 1 1-4.6-7.6" stroke-linecap="round" />
              <path d="M21 4.5v4h-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h2 class="mt-5 font-display font-semibold text-2xl text-fg">
            Find us on Google
          </h2>
          <p class="mt-3 text-[16px] leading-relaxed text-fg-muted">
            Our clients leave their feedback directly on our Google Business profile.
            Search for <strong>Essential Flooring Sacramento</strong> on Google to read
            recent reviews, or ask us for references from projects near you.
          </p>
          <a
            href={SITE.googleProfile}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-btn bg-control-dark hover:bg-control-dark-hover text-fg-on-dark font-semibold px-6 py-3 transition-colors"
          >
            See our Google profile
          </a>
        </div>
      )}

      <div class="reveal mt-14 rounded-card bg-surface-sunken/70 border border-hairline p-7 sm:p-9 text-center max-w-2xl mx-auto">
        <h2 class="font-display font-semibold text-xl text-fg">Worked with us recently?</h2>
        <p class="mt-2 text-[15px] text-fg-muted leading-relaxed">
          A short Google review helps a small local business more than any ad ever could. Thank you.
        </p>
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 font-semibold text-accent-on-light hover:text-fg transition-colors"
        >
          Follow our latest projects on Instagram
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
