---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import reviewsData from '../data/reviews.json';

// Real Google reviews go into src/data/reviews.json:
// { "author": "...", "rating": 5, "text": "...", "date": "2026-08-01", "city": "Roseville" }
type Review = { author: string; rating: number; text: string; date?: string; city?: string };
const reviews = reviewsData as Review[];
---

<Base
  title="Reviews | Essential Flooring, Sacramento CA"
  description="See what Sacramento homeowners say about Essential Flooring. Real Google reviews for hardwood refinishing, LVP, laminate and carpet installation."
>
  <section class="pt-10 pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'Reviews' }]} />
      <div class="mt-8 max-w-2xl">
        <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-ink">
          What our clients say
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-coffee">
          We would rather let the work and the people we worked for speak for us.
          These reviews come from our Google Business profile.
        </p>
      </div>

      {reviews.length > 0 ? (
        <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reviews.map((r) => (
            <li class="reveal rounded-2xl bg-paper border border-line p-7 shadow-card flex flex-col">
              <div class="flex items-center gap-1 text-oak">
                <span class="sr-only">Rated {r.rating} out of 5 stars</span>
                {Array.from({ length: r.rating }).map(() => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
                  </svg>
                ))}
              </div>
              <p class="mt-4 text-[15px] leading-relaxed text-bark flex-1">{r.text}</p>
              <p class="mt-5 font-semibold text-[15px] text-ink">
                {r.author}
                {r.city && <span class="font-normal text-coffee"> &middot; {r.city}</span>}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="reveal mt-12 rounded-3xl border border-line bg-paper shadow-card p-10 sm:p-14 text-center max-w-2xl mx-auto">
          <div class="inline-flex items-center gap-1.5 text-oak" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
              </svg>
            ))}
          </div>
          <h2 class="mt-5 font-display font-semibold text-2xl text-ink">
            Find us on Google
          </h2>
          <p class="mt-3 text-[16px] leading-relaxed text-coffee">
            Our clients leave their feedback directly on our Google Business profile.
            Search for <strong>Essential Flooring Sacramento</strong> on Google to read
            recent reviews, or ask us for references from projects near you.
          </p>
          <a
            href={SITE.googleProfile}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink hover:bg-bark text-cream font-semibold px-6 py-3 transition-colors"
          >
            See our Google profile
          </a>
        </div>
      )}

      <div class="reveal mt-14 rounded-2xl bg-sand/70 border border-line p-7 sm:p-9 text-center max-w-2xl mx-auto">
        <h2 class="font-display font-semibold text-xl text-ink">Worked with us recently?</h2>
        <p class="mt-2 text-[15px] text-coffee leading-relaxed">
          A short Google review helps our small crew more than any ad ever could. Thank you.
        </p>
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 font-semibold text-oak-deep hover:text-ink transition-colors"
        >
          Follow our latest projects on Instagram
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
