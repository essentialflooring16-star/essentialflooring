---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import { SERVICES, CORE_CITIES, EXTENDED_CITIES, ALL_CITIES } from '../../data/site';
import { photos, photoImage } from '../../lib/photos';
import citiesCopy from '../../data/cities.json';
import { getContent } from '../../lib/content';
import { parseQA } from '../../data/content/types';

const c = await getContent();

export function getStaticPaths() {
  return (citiesCopy as any[]).map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

type CityPage = {
  slug: string;
  city: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  intro: string;
  localContext: string;
  servicesBlock: string;
  whyUs: string;
  faq: { q: string; a: string }[];
};

const { page } = Astro.props as { page: CityPage };

// Textele proprii acestui oras. Cheile se compun din slug, iar implicitul
// fiecareia e chiar textul din cities.json, deci pagina arata neschimbat pana
// cand clientul chiar editeaza ceva din cabinet, oras cu oras.
const ck = `city.${page.slug}`;
const copy = {
  h1: c.or(`${ck}.h1`, page.h1),
  intro: c.or(`${ck}.intro`, page.intro),
  localContext: c.or(`${ck}.local_context`, page.localContext),
  servicesBlock: c.or(`${ck}.services_block`, page.servicesBlock),
  whyUs: c.or(`${ck}.why_us`, page.whyUs),
  faq: c.isEdited(`${ck}.faq`) ? parseQA(c(`${ck}.faq`)) : page.faq,
};
const introParas = copy.intro.split(/\n\n+/);
const metaDescription = c.apply(page.metaDescription);

// Rotate hero photos across city pages so they don't all look identical.
const heroPool = photos.filter((p) => p.hero);
const idx = (citiesCopy as any[]).findIndex((c) => c.slug === page.slug);
const heroPhoto = heroPool[idx % heroPool.length];

const isExtended = EXTENDED_CITIES.some((c) => c.slug === page.slug);
// A region reads with an article in running text ("the San Francisco Bay
// Area"); a town does not. The breadcrumb keeps the bare name.
const isRegion = ALL_CITIES.some((c) => c.slug === page.slug && 'region' in c && c.region);
const place = isRegion ? `the ${page.city}` : page.city;
const nearby = (isExtended ? CORE_CITIES.slice(0, 6) : CORE_CITIES.filter((c) => c.slug !== page.slug).slice(0, 6));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Flooring installation and refinishing in ${isRegion ? page.city : page.city + ', CA'}`,
  serviceType: 'Flooring installation',
  provider: { '@id': `${c.site.domain}/#business` },
  areaServed: isRegion ? page.city : `${page.city}, CA`,
  description: metaDescription,
};
---

<Base title={page.metaTitle} description={metaDescription} schema={[serviceSchema]}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-surface-dark">
    <Image
      src={photoImage(heroPhoto.id)}
      alt={heroPhoto.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={65}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-scrim via-scrim/60 to-scrim/30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-10 pb-12 sm:pb-20">
      <Breadcrumbs light crumbs={[{ label: 'Service Areas', href: '/service-areas/' }, { label: page.city }]} />
      <h1 class="mt-10 font-display font-semibold text-fg-on-dark text-4xl sm:text-5xl leading-[1.08] tracking-tight max-w-2xl text-balance">
        {copy.h1}
      </h1>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a
          href="/contact/"
          class="inline-flex justify-center items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-7 py-3.5 transition-colors shadow-lift"
        >
          Get a free estimate
        </a>
        <a
          href={c.site.phoneHref}
          class="inline-flex justify-center items-center rounded-btn border border-hairline-on-dark/30 hover:border-hairline-on-dark/60 text-fg-on-dark font-semibold px-7 py-3.5 transition-colors"
        >
          Call {c.site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid lg:grid-cols-[1fr_360px] gap-12">
      <article class="max-w-2xl">
        {introParas.map((p) => (
          <p class="text-[17px] leading-relaxed text-fg-body mb-5">{p}</p>
        ))}

        <h2 class="mt-10 font-display font-semibold text-2xl text-fg">
          Flooring that fits {place}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-fg-muted">{copy.localContext}</p>

        <h2 class="mt-10 font-display font-semibold text-2xl text-fg">
          {c('city_page.body.services_title')}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-fg-muted">{copy.servicesBlock}</p>

        <div class="mt-8 grid sm:grid-cols-2 gap-4">
          {SERVICES.map((s) => (
            <a
              href={`/services/${s.slug}/`}
              class="group rounded-card border border-hairline bg-surface-raised px-5 py-4 shadow-card hover:shadow-lift transition-shadow"
            >
              <span class="font-semibold text-[15px] text-fg group-hover:text-accent-on-light transition-colors">
                {s.name}
              </span>
            </a>
          ))}
        </div>

        <h2 class="mt-10 font-display font-semibold text-2xl text-fg">
          {c('city_page.body.why_title')}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-fg-muted">{copy.whyUs}</p>
      </article>

      <aside class="reveal rounded-card bg-surface-raised border border-hairline shadow-card p-7 h-fit lg:sticky lg:top-24">
        <h2 class="font-display font-semibold text-xl text-fg">
          Free estimate in {place}
        </h2>
        <p class="mt-3 text-[14.5px] leading-relaxed text-fg-muted">
          {isExtended
            ? 'Tell us about your rooms and floors. For projects outside the Sacramento area we scope the job from your measurements and photos first, then confirm on site before any work starts.'
            : 'Tell us about your rooms and floors. We measure on site and send a clear written quote, free of charge.'}
        </p>
        <a
          href="/contact/"
          class="mt-5 w-full inline-flex justify-center items-center rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-6 py-3 transition-colors"
        >
          Get a free estimate
        </a>
        <a
          href={c.site.phoneHref}
          class="mt-3 w-full inline-flex justify-center items-center rounded-btn border border-hairline hover:border-accent text-fg font-semibold px-6 py-3 transition-colors"
        >
          Call {c.site.phone}
        </a>
        <p class="mt-5 text-[13px] text-fg-muted/80 text-center">
          Licensed &amp; Bonded, {c.site.license}
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-surface-sunken/60">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="reveal font-display font-semibold text-3xl text-fg tracking-tight text-center">
        Flooring in {place}: common questions
      </h2>
      <div class="reveal mt-10">
        <FaqList items={copy.faq} />
      </div>
    </div>
  </section>

  <!-- NEARBY -->
  <section class="py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="reveal font-semibold text-[15px] uppercase tracking-[0.16em] text-fg-muted mb-5">
        {isRegion ? 'Other areas we serve' : 'Nearby areas we serve'}
      </h2>
      <ul class="flex flex-wrap gap-3">
        {nearby.map((c) => (
          <li>
            <a
              href={`/service-areas/${c.slug}/`}
              class="inline-flex rounded-btn border border-hairline bg-surface-raised px-4 py-2 text-[14px] font-medium text-fg-body hover:border-accent hover:text-accent-on-light transition-colors"
            >
              {c.city}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/service-areas/"
            class="inline-flex rounded-btn bg-surface-dark text-fg-on-dark px-4 py-2 text-[14px] font-medium hover:bg-control-dark-hover transition-colors"
          >
            All service areas
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title={`Ready to upgrade your floors in ${place}?`}
    text={isExtended
      ? 'Free estimate, dates agreed in writing, licensed contractor. It starts with one call.'
      : 'Free estimate, clear timeline, licensed contractor. It starts with one call.'}
  />
</Base>
