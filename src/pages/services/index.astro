---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, ALL_SERVICES } from '../../data/site';
import { photoImage, photoById } from '../../lib/photos';

const extras = [
  { t: 'Tile & linoleum', d: 'Tile and linoleum installation for kitchens, bathrooms and laundry rooms.' },
  { t: 'Floor removal', d: 'We tear out old carpet, laminate or damaged wood and haul it away.' },
  { t: 'Leveling & grinding', d: 'Surface preparation so the new floor sits flat and lasts.' },
  { t: 'Baseboards & transitions', d: 'Clean transitions and finished edges in every room.' },
];
---

<Base
  title="Flooring Services in Sacramento, CA | Essential Flooring"
  description="Hardwood refinishing, LVP and vinyl plank, laminate and carpet installation in Sacramento. Licensed and insured, free estimates. Call (916) 425-1361."
>
  <section class="pt-10 pb-16 sm:pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'Services' }]} />
      <div class="mt-8 max-w-2xl">
        <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-ink">
          Flooring services, done right
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-coffee">
          From reviving original hardwood to installing waterproof LVP in a busy family
          kitchen, we handle the whole project with one licensed contractor. Every job starts
          with a free estimate and a transparent written quote.
        </p>
      </div>

      <div class="mt-14 grid gap-8">
        {SERVICES.map((s, i) => (
          <a
            href={`/services/${s.slug}`}
            class={`reveal group grid md:grid-cols-2 rounded-3xl overflow-hidden bg-paper border border-line shadow-card hover:shadow-lift transition-shadow`}
          >
            <div class={`aspect-[16/10] md:aspect-auto md:min-h-[300px] overflow-hidden ${i % 2 ? 'md:order-2' : ''}`}>
              <Image
                src={photoImage(s.image)}
                alt={photoById(s.image).alt}
                widths={[640, 960]}
                sizes="(min-width:768px) 50vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                format="webp"
                quality={72}
              />
            </div>
            <div class="p-8 sm:p-10 flex flex-col justify-center">
              <h2 class="font-display font-semibold text-2xl sm:text-3xl text-ink group-hover:text-oak-deep transition-colors">
                {s.name}
              </h2>
              <p class="mt-3 text-[16px] leading-relaxed text-coffee max-w-md">{s.short}</p>
              <span class="mt-6 inline-flex items-center gap-2 font-semibold text-oak-deep">
                Explore this service
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-sand/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading
        eyebrow="Also included"
        title="The details a rushed job skips"
        text="A floor is only as good as what is under it and around it."
      />
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {extras.map((e) => (
          <li class="reveal rounded-2xl bg-paper border border-line p-6 shadow-card">
            <h3 class="font-display font-semibold text-[18px] text-ink">{e.t}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-coffee">{e.d}</p>
          </li>
        ))}
      </ul>

      <div class="reveal mt-12">
        <h3 class="font-semibold text-[15px] uppercase tracking-[0.16em] text-coffee mb-5">
          The complete list, all under one roof
        </h3>
        <ul class="flex flex-wrap gap-2">
          {ALL_SERVICES.map((s) => (
            <li class="rounded-full bg-paper border border-line px-3.5 py-1.5 text-[13.5px] font-medium text-bark">
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
