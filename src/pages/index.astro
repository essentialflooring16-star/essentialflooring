---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import ServiceCards from '../components/ServiceCards.astro';
import VideoStrip from '../components/VideoStrip.astro';
import ShowcaseSlider from '../components/ShowcaseSlider.tsx';
import { SITE, ALL_SERVICES, CORE_CITIES, EXTENDED_CITIES } from '../data/site';
import { photos, photoImage, photoById } from '../lib/photos';
import faqData from '../data/faq.json';
import pairsData from '../data/before-after.json';
import { getReviews, ratingSummary } from '../lib/reviews';

// The teaser shows stars only when real reviews exist, and shows the true
// average rather than a decorative five.
const homeReviews = await getReviews();
const reviewSummary = ratingSummary(homeReviews);
const hasReviews = reviewSummary !== null;


// Before/After showcase: real client-labeled pairs, same-spot first.
const baModules = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  '../assets/before-after/*.jpg',
  { eager: true },
);
const baImage = (file: string) => {
  const mod = Object.entries(baModules).find(([p]) => p.endsWith(`/${file}`));
  if (!mod) throw new Error(`Before/after image missing: ${file}`);
  return mod[1].default;
};
const showcasePairs = await Promise.all(
  (pairsData as any[])
    .filter((p) => p.sameSpot)
    .slice(0, 6)
    .map(async (p) => {
      const before = await getImage({ src: baImage(p.before), width: 1400, format: 'webp', quality: 74 });
      const after = await getImage({ src: baImage(p.after), width: 1400, format: 'webp', quality: 74 });
      const thumb = await getImage({ src: baImage(p.after), width: 200, format: 'webp', quality: 60 });
      return {
        id: p.id,
        beforeSrc: before.src,
        afterSrc: after.src,
        thumbSrc: thumb.src,
        label: p.label,
        city: p.city,
        caption: p.caption,
      };
    }),
);

// The hero photograph. Landscape is the constraint that picks it: almost the
// whole library is vertical phone shots, and hardwood-refinishing-02 is the
// one high-quality frame that is already 4:3, so a wide crop of it keeps
// real pixels instead of upscaling a portrait.
const heroPhoto = photoById('hardwood-refinishing-02');

const previewPhotos = photos
  .filter((p) => p.state === 'after')
  .sort((a, b) => b.quality - a.quality)
  .slice(0, 7);

const faqPreview = (faqData as { q: string; a: string }[]).slice(0, 4);

const steps = [
  {
    title: 'Free consultation',
    text: 'We visit your home, measure the space, and talk through materials, colors and budget. You get a clear written quote with no hidden fees.',
  },
  {
    title: 'Preparation',
    text: 'We remove old flooring when needed, level and grind the subfloor, and acclimate materials so your new floor stays flat and stable.',
  },
  {
    title: 'Expert installation',
    text: 'Every floor is installed or refinished with care for the details: tight seams, clean transitions, straight lines and finished baseboards.',
  },
  {
    title: 'Final walkthrough',
    text: 'We inspect every room together, clean up completely, and hand you a floor that is ready to live on from day one.',
  },
];

const marqueeItems = [
  'Hardwood Refinishing', 'LVP Installation', 'Stairs', 'Laminate', 'Tile',
  'Carpet', 'Floor Repairs', 'Baseboards', 'Free Estimates',
];
---

<Base
  title="Essential Flooring | Flooring Contractor in Sacramento, CA"
  description="Licensed Sacramento flooring contractor. Hardwood floor refinishing, waterproof LVP, stairs, laminate and carpet. Free estimates, call (916) 425-1361."
>
  <!-- HERO
       Rebuilt after studying walkerwarner.com, marasrl.it and icebug.com. In
       all three the photograph is the hero and the type is small, quiet and
       pushed to an edge; none of them opens with a headline block and two
       buttons. That register suits this client for a practical reason: the
       one asset we have in quantity is photographs of finished floors, and
       the floor is the only part of a phone photo of an empty house that is
       beautiful. Cropping wide and low fills the frame with grain and leaves
       the room out of it.

       The h1 changed from a slogan to a sentence that names the work and the
       area. "See the difference, not the promise" carried no search term at
       all, and it is the single most valuable string on the site. -->
  <section class="relative bg-fg">
    <div class="relative h-[64svh] min-h-[400px] sm:h-[72svh] lg:h-[80svh] overflow-hidden">
      <Image
        src={photoImage(heroPhoto.file)}
        alt={heroPhoto.alt}
        widths={[900, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover [object-position:50%_74%]"
      />
      <!-- Two scrims, not one: a wide soft one for the type and a short hard
           one at the very bottom so the meta row stays legible on the light
           reflections in the finish. -->
      <div
        class="absolute inset-x-0 bottom-0 h-[78%] bg-gradient-to-t from-scrim-media/88 via-scrim-media/40 to-transparent"
        aria-hidden="true"
      ></div>

      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 pb-8 sm:pb-11">
          <p class="m-intro text-fg-on-media/70 text-[11px] font-bold uppercase tracking-[0.22em]">
            {heroPhoto.city}, California
          </p>
          <h1
            style="--i:1"
            class="m-intro mt-4 font-display font-semibold text-fg-on-media text-[28px] sm:text-[40px] lg:text-[50px] leading-[1.04] max-w-[19ch] sm:max-w-[24ch] [text-wrap:balance]"
          >
            Hardwood refinishing, vinyl plank and stairs in greater Sacramento
          </h1>
          <div class="m-intro mt-7 sm:mt-9 flex flex-wrap items-center gap-x-7 gap-y-4" style="--i:2">
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-7 py-3.5 text-[15px] transition-colors"
            >
              Get a free estimate
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a
              href={SITE.phoneHref}
              class="text-fg-on-media font-display font-semibold text-[19px] sm:text-[21px] underline-offset-[6px] hover:underline"
            >
              {SITE.phone}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- The line that used to be a row of bullet points under the headline.
         As a rule under the photograph it carries the same four facts without
         asking for a third of the first screen. -->
    <div class="bg-surface border-b border-hairline">
      <div
        class="mx-auto max-w-6xl px-4 sm:px-6 py-4 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-3 text-[13px] text-fg-muted"
      >
        <p><span class="text-fg font-semibold">Licensed &amp; insured</span> {SITE.license}</p>
        <p><span class="text-fg font-semibold">Mon to Sat</span> 7 AM to 7 PM</p>
        <p><span class="text-fg font-semibold">{CORE_CITIES.length + EXTENDED_CITIES.length} areas</span> around Sacramento</p>
        <p><span class="text-fg font-semibold">Free estimates</span> no call-out fee</p>
      </div>
    </div>

    <Marquee items={marqueeItems} />
  </section>

  <!-- SERVICES: editorial numbered index -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
        <SectionHeading
          eyebrow="Services"
          title="What we install and refinish"
          text="From tear-out to the last baseboard, one licensed contractor owns the whole job. No handoffs, no finger-pointing."
        />
        <a
          href="/services/"
          class="reveal shrink-0 inline-flex items-center gap-2 font-semibold text-accent-on-light hover:text-fg transition-colors"
        >
          All 16 services
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <ServiceCards />

      <ul class="reveal mt-8 flex flex-wrap gap-2">
        {ALL_SERVICES.map((s) => (
          <li class="rounded-btn bg-surface-sunken border border-hairline px-3.5 py-1.5 text-[13px] font-medium text-fg-body">
            {s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BEFORE / AFTER SHOWCASE -->
  <section class="grain py-16 sm:py-24 bg-surface-dark relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-[380px_1fr] gap-12 items-start">
        <div class="lg:sticky lg:top-28">
          <SectionHeading
            eyebrow="Before and after"
            title="The same room, photographed twice"
            text="Every pair below was shot on real Sacramento area projects. Pick a project, pull the slider, and see exactly what we walked into and what we left behind."
            light
          />
          <div class="reveal mt-8">
            <a
              href="/portfolio/"
              class="inline-flex items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-6 py-3 transition-colors"
            >
              See all 12 pairs
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <div class="m-rise">
          <ShowcaseSlider client:load pairs={showcasePairs} />
        </div>
      </div>

      <div class="reveal mt-14">
        <Stats dark />
      </div>
    </div>
  </section>

  <!-- PROCESS
       Was four centred squares numbered 1 to 4 with a connector line through
       them, which is the stock "how it works" block and reads as filler. It is
       now the same editorial index the services use: the heading holds the
       left column while the steps scroll past it, each step a row on a
       hairline with the numeral set in the margin. -->
  <section class="py-16 sm:py-24 relative">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-[340px_1fr] gap-10 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28">
          <SectionHeading
            eyebrow="Process"
            title="From the first call to the final walkthrough"
          />
        </div>
        <ol class="border-t border-hairline">
          {steps.map((step, i) => (
            <li class="m-rise grid grid-cols-[3rem_1fr] sm:grid-cols-[5rem_1fr] gap-x-4 py-7 border-b border-hairline">
              <span class="font-display font-semibold text-[15px] text-accent-on-light tabular-nums pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-display font-semibold text-[20px] sm:text-[22px] text-fg">{step.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-fg-muted max-w-xl">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Marquee items={[...CORE_CITIES.map((c) => c.city)]} />

  <!-- PORTFOLIO MOSAIC -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
        <SectionHeading
          eyebrow="Recent work"
          title="Floors we finished around Sacramento"
          text="Every photo is our own work in the Sacramento area, straight off the phone, on the job."
        />
        <a
          href="/portfolio/"
          class="reveal shrink-0 inline-flex items-center gap-2 font-semibold text-accent-on-light hover:text-fg transition-colors"
        >
          Browse the full portfolio
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <ul class="grid grid-cols-2 lg:grid-cols-4 auto-rows-[150px] sm:auto-rows-[190px] gap-3 sm:gap-4">
        {previewPhotos.map((p, i) => {
          const spans = [
            'col-span-2 row-span-2',
            'row-span-2',
            '',
            '',
            'row-span-2',
            '',
            'col-span-2',
          ];
          return (
            <li class={`m-rise ${spans[i] ?? ''}`} style={`--i:${i}`}>
              <a href="/portfolio/" class="group relative block overflow-hidden rounded-media h-full">
                <Image
                  src={photoImage(p.id)}
                  alt={p.alt}
                  widths={[400, 640, 900]}
                  sizes="(min-width:1024px) 25vw, 50vw"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                  format="webp"
                  quality={70}
                />
                <span class="absolute inset-0 bg-gradient-to-t from-scrim-media/55 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></span>
                <span class="absolute bottom-0 left-0 right-0 p-4 text-fg-on-media text-[13.5px] font-medium opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all">
                  {p.caption}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <VideoStrip />

  <!-- WHY US + AREAS -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid lg:grid-cols-2 gap-14">
      <div>
        <SectionHeading
          eyebrow="About"
          title="Licensed, insured, and on the job himself"
        />
        <ul class="mt-8 space-y-5">
          {[
            {
              t: 'California licensed contractor',
              d: `We operate under ${SITE.license}, fully insured. You are protected, and the work is up to code.`,
            },
            {
              t: 'Transparent quotes',
              d: 'Your written estimate spells out materials, labor and timeline. The price we quote is the price you pay.',
            },
            {
              t: 'On-time completion',
              d: 'Flooring work disrupts your routine, so we plan carefully and finish when we said we would.',
            },
            {
              t: 'Prep work done properly',
              d: 'Old flooring out, subfloor levelled and cleaned, moisture checked. The part you never see is what keeps a floor flat.',
            },
          ].map((item) => (
            <li class="reveal flex gap-4">
              <span class="shrink-0 grid place-items-center size-9 rounded-btn bg-accent-wash text-accent-on-light mt-0.5" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <h3 class="font-semibold text-[17px] text-fg">{item.t}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-fg-muted">{item.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal rounded-card bg-surface-raised border border-hairline shadow-card p-7 sm:p-9 h-fit">
        <h3 class="font-display font-semibold text-2xl text-fg">Where we work</h3>
        <p class="mt-2 text-[15px] text-fg-muted leading-relaxed">
          Based in Sacramento, serving homes across the region.
        </p>
        <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2.5 text-[15px]">
          {CORE_CITIES.map((c) => (
            <li>
              <a
                href={`/service-areas/${c.slug}/`}
                class="inline-flex items-center gap-2 text-fg-body hover:text-accent-on-light transition-colors"
              >
                <span class="size-1 rounded-full bg-accent" aria-hidden="true"></span>
                {c.city}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[13.5px] text-fg-muted/85 leading-relaxed">
          Select projects also in {EXTENDED_CITIES.map((c) => c.city).join(', ')}.
        </p>
        <a href="/service-areas/" class="mt-4 inline-flex items-center gap-1.5 font-semibold text-accent-on-light hover:text-fg transition-colors text-[15px]">
          All service areas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- REVIEWS TEASER: the star row and the rating claim only appear once real
       reviews exist in reviews.json. With none, we link out to Google instead
       of implying a rating we cannot show. -->
  <section class="py-16 bg-surface-sunken/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
      {hasReviews && (
        <div class="reveal inline-flex items-center gap-2">
          <span class="flex items-center gap-1 text-accent-display" aria-hidden="true">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg width="22" height="22" viewBox="0 0 24 24" fill={i < Math.round(reviewSummary!.average) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
              </svg>
            ))}
          </span>
          <span class="text-[16px] font-semibold text-fg">
            {reviewSummary!.average.toFixed(1)}
          </span>
          <span class="text-[15px] text-fg-muted">
            from {reviewSummary!.count} Google {reviewSummary!.count === 1 ? 'review' : 'reviews'}
          </span>
        </div>
      )}
      <h2 class="reveal mt-4 font-display font-semibold text-2xl sm:text-3xl text-fg">
        {hasReviews ? 'What customers say' : 'Reviews'}
      </h2>
      <p class="reveal mt-3 text-fg-muted max-w-lg mx-auto text-[16px]">
        {hasReviews
          ? 'Read what Sacramento homeowners think about working with us, straight from Google.'
          : 'Our reviews live on our Google Business Profile, along with photos from recent jobs around Sacramento.'}
      </p>
      <a
        href={hasReviews ? '/reviews' : SITE.googleProfile}
        target={hasReviews ? undefined : '_blank'}
        rel={hasReviews ? undefined : 'noopener'}
        class="reveal mt-6 inline-flex items-center gap-2 rounded-btn bg-control-dark hover:bg-control-dark-hover text-fg-on-dark font-semibold px-6 py-3 transition-colors"
      >
        {hasReviews ? 'Read our reviews' : 'See us on Google'}
      </a>
    </div>
  </section>

  <!-- FAQ PREVIEW -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <SectionHeading eyebrow="FAQ" title="Questions we get asked" align="center" />
      <div class="reveal mt-10">
        <FaqList items={faqPreview} withSchema={false} />
      </div>
      <p class="reveal mt-6 text-center">
        <a href="/faq/" class="font-semibold text-accent-on-light hover:text-fg transition-colors">
          See all questions
        </a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Gentle parallax drift on hero images (transform-only, rAF-throttled).
  const els = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !reduced) {
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = window.scrollY;
      for (const el of els) {
        const f = Number(el.dataset.parallax || '0');
        el.style.transform = `translateY(${Math.round(y * f * 100) / 100}px)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }
</script>
