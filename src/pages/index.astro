---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Stats from '../components/Stats.astro';
import ServiceCards from '../components/ServiceCards.astro';
import WorkInProgress from '../components/WorkInProgress.astro';
import ShowcaseSlider from '../components/ShowcaseSlider.astro';
import Icon from '../components/Icon.astro';
import { ALL_SERVICES, CORE_CITIES, EXTENDED_CITIES } from '../data/site';
import { photos, photoImage, photoById } from '../lib/photos';
import faqData from '../data/faq.json';
import pairsData from '../data/before-after.json';
import { getReviews, ratingSummary } from '../lib/reviews';
import { getContent } from '../lib/content';

const c = await getContent();

// The teaser shows stars only when real reviews exist, and shows the true
// average rather than a decorative five.
const homeReviews = await getReviews();
const reviewSummary = ratingSummary(homeReviews);
const hasReviews = reviewSummary !== null;

// Before/After showcase: real client-labeled pairs, same-spot first.
const baModules = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  '../assets/before-after/*.jpg',
  { eager: true },
);
const baImage = (file: string) => {
  const mod = Object.entries(baModules).find(([p]) => p.endsWith(`/${file}`));
  if (!mod) throw new Error(`Before/after image missing: ${file}`);
  return mod[1].default;
};
const showcasePairs = await Promise.all(
  (pairsData as any[])
    .filter((p) => p.sameSpot)
    .slice(0, 6)
    .map(async (p) => {
      // The slider column is about 680px wide on a desktop and the full width
      // of a phone, so a single 1400px file made a phone download roughly four
      // times the pixels it could show. These widths let it pick.
      const SHOWCASE_WIDTHS = [420, 680, 900, 1360];
      const before = await getImage({ src: baImage(p.before), widths: SHOWCASE_WIDTHS, format: 'webp', quality: 74 });
      const after = await getImage({ src: baImage(p.after), widths: SHOWCASE_WIDTHS, format: 'webp', quality: 74 });
      const thumb = await getImage({ src: baImage(p.after), width: 200, format: 'webp', quality: 60 });
      return {
        id: p.id,
        beforeSrc: before.src,
        beforeSrcset: before.srcSet.attribute,
        afterSrc: after.src,
        afterSrcset: after.srcSet.attribute,
        thumbSrc: thumb.src,
        label: p.label,
        city: p.city,
        caption: p.caption,
      };
    }),
);

// The hero photograph. Landscape is the constraint that picks it: almost the
// whole library is vertical phone shots, and hardwood-refinishing-02 is the
// one high-quality frame that is already 4:3, so a wide crop of it keeps
// real pixels instead of upscaling a portrait.
const heroPhoto = photoById('hardwood-refinishing-02');
// Cel mai mare paint al paginii. Doua formate, ca telefoanele care stiu AVIF sa
// ia jumatate din octeti, si trepte mici, fiindca un Moto G cere ~720px, nu 900.
const HERO_WIDTHS = [560, 760, 900, 1400, 2000, 2600];
const heroAvif = await getImage({ src: photoImage(heroPhoto.file), widths: HERO_WIDTHS, format: 'avif', quality: 44 });
const heroWebp = await getImage({ src: photoImage(heroPhoto.file), widths: HERO_WIDTHS, format: 'webp', quality: 70 });

const previewPhotos = photos
  .filter((p) => p.state === 'after')
  .sort((a, b) => b.quality - a.quality)
  .slice(0, 8);

const faqAll = c.isEdited('faq.items')
  ? parseQA(c('faq.items'))
  : (faqData as { q: string; a: string }[]).map((i) => ({ q: c.apply(i.q), a: c.apply(i.a) }));
const faqPreview = faqAll.slice(0, 4);

// "Also serving" splits the extended list into towns and regions so a region
// entry (the Bay Area) reads as its own clause instead of as one more town.
const extendedTowns = EXTENDED_CITIES.filter((c) => !('region' in c && c.region));
const extendedRegions = EXTENDED_CITIES.filter((c) => 'region' in c && c.region);
const alsoServing =
  'Also serving ' +
  extendedTowns.map((c) => c.city).join(', ') +
  (extendedRegions.length
    ? ', and the ' + extendedRegions.map((c) => c.city).join(' and ') + ' for select projects'
    : '') +
  '.';

const steps = [
  {
    title: 'Free consultation',
    text: 'We visit your home, measure the space, and talk through materials, colors and budget. You get a clear written quote with no hidden fees.',
  },
  {
    title: 'Preparation',
    text: 'We remove old flooring when needed, level and grind the subfloor, and acclimate materials so your new floor stays flat and stable.',
  },
  {
    title: 'Expert installation',
    text: 'Every floor is installed or refinished with care for the details: tight seams, clean transitions, straight lines and finished baseboards.',
  },
  {
    title: 'Final walkthrough',
    text: 'We inspect every room together, clean up completely, and hand you a floor that is ready to live on from day one.',
  },
];

---

<Base
  title="Sacramento Flooring Contractor | Essential Flooring"
  description="Licensed Sacramento flooring contractor. Hardwood refinishing, waterproof LVP, stair installation, laminate and carpet. Free estimates, call (916) 425-1361."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroAvif.srcSet.attribute}
    imagesizes="100vw"
    fetchpriority="high"
  />
  <!-- HERO
       Direction E: the editorial opening of the premium wood-flooring class
       (tedtodd.co.uk is the palette anchor). The statement comes first, set
       in the serif with one italic copper flourish; the photograph follows,
       framed in the paper ground, with the place label pinned to its corner.
       The h1 carries the search terms: contractor plus city on the first
       line, the three services on the second, and the sub-headline under it
       repeats the long-tail phrase (refinishing, vinyl plank, stairs,
       greater Sacramento). -->
  <section class="relative bg-surface overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-12 sm:pt-16 lg:pt-20">
      <!-- Maker's stamp: fills the right of the statement on wide screens,
           turning once every 28s. Pure SVG, three palette colours only. -->
      <div class="hidden lg:block absolute right-6 top-24 size-[164px] select-none" aria-hidden="true">
        <svg viewBox="0 0 164 164" class="size-full animate-stamp-spin motion-reduce:animate-none">
          <defs>
            <path id="stamp-arc" d="M82 12a70 70 0 1 1 0 140a70 70 0 1 1 0-140" />
          </defs>
          <text class="font-display" fill="var(--ef-accent-on-light)" font-size="13.5" font-weight="600" letter-spacing="3.4">
            <textPath href="#stamp-arc" startOffset="0">EST. 2023 · SACRAMENTO CA · LICENSED &amp; INSURED ·</textPath>
          </text>
        </svg>
        <svg viewBox="0 0 28 28" class="absolute inset-0 m-auto size-11" fill="none">
          <rect x="4" y="9" width="20" height="4.5" rx="1" transform="rotate(-14 14 11)" fill="var(--ef-accent-fill)" />
          <rect x="4" y="16.5" width="20" height="4.5" rx="1" transform="rotate(-14 14 18.5)" fill="var(--ef-dark-control)" />
        </svg>
      </div>

      <!-- The statement enters one line at a time, each line rising out of a
           soft blur, so the first thing the visitor reads is also the first
           thing that moves. Line one is the contractor and the city, line two
           the three services; the sub-headline below takes the same entrance
           as a third line, and the CTA row follows at the next index.
           Weight and tracking come from the global h1 rule (800, -0.028em).
           From lg the h1 stops 190px short of the column edge so neither
           line can run under the stamp (164px wide, 24px in). -->
      <h1 class="font-display text-fg text-[30px] sm:text-[46px] xl:text-[52px] leading-[1.06] lg:max-w-[calc(100%-190px)] [text-wrap:balance]">
        <span class="m-line block" style="--i:0">{c('home.hero.title_line_1')}</span>
        <span class="m-line block" style="--i:1">{c('home.hero.title_line_2')} <span class="accent-italic">{c('home.hero.title_accent')}</span></span>
      </h1>
      <p class="m-line mt-5 sm:mt-6 max-w-2xl text-[17px] sm:text-[20px] leading-snug text-fg-muted" style="--i:2">{c('home.hero.subtitle')}</p>

      <div class="m-intro mt-8 sm:mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" style="--i:3">
        <a
          href="/contact/"
          class="arrow-link inline-flex items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-7 py-3.5 text-[15px] transition-colors shadow-card"
        >
          {c('home.hero.cta_label')}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href={c.site.phoneHref}
          class="font-display font-medium text-fg text-[20px] sm:text-[22px] underline-offset-[6px] decoration-accent/60 hover:underline"
        >
          {c.site.phone}
        </a>
        <p class="basis-full sm:basis-auto text-[13.5px] text-fg-muted">
          {c('home.hero.cta_note')}
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-[1400px] px-3 sm:px-5 mt-10 sm:mt-14">
      <!-- No entrance animation on this one on purpose: it is the largest paint
           on the page, and .m-media fades in on a view() timeline, so above the
           fold the browser held it at partial opacity and the measured paint
           landed 2.5s late. The parallax drift stays, it moves no opacity. -->
      <figure class="parallax relative overflow-hidden rounded-card shadow-lift">
        <picture>
          <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes="100vw" />
          <img
            src={heroWebp.src}
            srcset={heroWebp.srcSet.attribute}
            sizes="100vw"
            alt={heroPhoto.alt}
            width={heroWebp.attributes.width}
            height={heroWebp.attributes.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="parallax-img h-[46svh] min-h-[320px] sm:h-[56svh] lg:h-[64svh] w-full object-cover [object-position:50%_74%]"
          />
        </picture>
        <figcaption
          class="absolute left-4 bottom-4 sm:left-6 sm:bottom-6 inline-flex items-center gap-2.5 rounded-btn bg-scrim-media/55 backdrop-blur-[2px] text-fg-on-media text-[12px] font-semibold uppercase tracking-[0.14em] px-3.5 py-2"
        >
          <span class="size-1.5 bg-accent-display" aria-hidden="true"></span>
          {heroPhoto.city}, California. Our work
        </figcaption>
      </figure>
    </div>

    <!-- Facts, each stamped with the site's own icon set. -->
    <div class="mx-auto max-w-6xl px-4 sm:px-6 mt-8 sm:mt-10 mb-2">
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-5 text-[13.5px] text-fg-muted border-t border-hairline pt-6">
        <li class="flex items-center gap-3">
          <Icon name="shield" size={26} class="shrink-0 text-fg" />
          <span><span class="block text-fg font-semibold">Licensed &amp; insured</span>{c.site.license}</span>
        </li>
        <li class="flex items-center gap-3">
          <Icon name="clock" size={26} class="shrink-0 text-fg" />
          <span><span class="block text-fg font-semibold">Mon to Sat</span>7 AM to 7 PM</span>
        </li>
        <li class="flex items-center gap-3">
          <Icon name="pin" size={26} class="shrink-0 text-fg" />
          <span><span class="block text-fg font-semibold">{CORE_CITIES.length + EXTENDED_CITIES.length} cities and areas</span>across Northern California</span>
        </li>
        <li class="flex items-center gap-3">
          <Icon name="ruler" size={26} class="shrink-0 text-fg" />
          <span><span class="block text-fg font-semibold">Free estimates</span>written, no hidden fees</span>
        </li>
      </ul>
    </div>

  </section>

  <!-- SERVICES: framed pictures on the green wall -->
  <section class="grain py-16 sm:py-24 bg-surface-dark relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
        <SectionHeading
          eyebrow="Services"
          title={c('home.services.title')}
          text={c('home.services.intro')}
          light
        />
        <a
          href="/services/"
          class="reveal arrow-link shrink-0 inline-flex items-center gap-2 font-semibold text-accent-on-dark hover:text-fg-on-dark transition-colors"
        >
          All 16 services
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <ServiceCards />

    </div>
  </section>

  <!-- BEFORE / AFTER SHOWCASE -->
  <section class="py-16 sm:py-24 bg-surface-sunken/60 border-y border-hairline relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-[380px_1fr] gap-12 items-start">
        <div class="lg:sticky lg:top-28">
          <SectionHeading
            eyebrow="Before and after"
            title={c('home.before_after.title')}
            text={c('home.before_after.intro')}
          />
          <div class="reveal mt-8">
            <a
              href="/portfolio/"
              class="arrow-link inline-flex items-center gap-2 rounded-btn bg-accent hover:bg-accent-hover text-fg-on-accent font-semibold px-6 py-3 transition-colors"
            >
              See all 12 pairs
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
        <div class="m-rise">
          <ShowcaseSlider pairs={showcasePairs} />
        </div>
      </div>

      <div class="reveal mt-14">
        <Stats dark={false} />
      </div>
    </div>
  </section>

  <!-- PROCESS
       Was four centred squares numbered 1 to 4 with a connector line through
       them, which is the stock "how it works" block and reads as filler. It is
       now the same editorial index the services use: the heading holds the
       left column while the steps scroll past it, each step a row on a
       hairline with the numeral set in the margin. -->
  <section class="py-16 sm:py-24 relative">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-[340px_1fr] gap-10 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28">
          <SectionHeading
            eyebrow="Process"
            title={c('home.process.title')}
          />
          <figure class="m-rise hidden lg:block mt-10 rounded-card bg-surface-raised p-2.5 pb-0 shadow-card max-w-[300px]">
            <span class="parallax block overflow-hidden rounded-media">
              <Image
                src={photoImage('stairs-01')}
                alt={photoById('stairs-01').alt}
                widths={[300, 600]}
                sizes="300px"
                class="parallax-img aspect-[4/5] w-full object-cover"
                format="webp"
                quality={70}
              />
            </span>
            <figcaption class="px-2.5 py-3.5 text-[13px] text-fg-muted">
              <span class="block font-display font-medium text-[15px] text-fg">Owner operated</span>
              One person responsible from estimate to final walkthrough.
            </figcaption>
          </figure>
        </div>
        <ol class="border-t border-hairline">
          {steps.map((step, i) => (
            <li class="m-rise grid grid-cols-[3rem_1fr] sm:grid-cols-[5rem_1fr] gap-x-4 py-7 border-b border-hairline">
              <span class="font-display font-semibold text-[15px] text-accent-on-light tabular-nums pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-display font-semibold text-[20px] sm:text-[22px] text-fg">{step.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-fg-muted max-w-xl">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO MOSAIC -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
        <SectionHeading
          eyebrow="Recent work"
          title={c('home.portfolio.title')}
          text={c('home.portfolio.intro')}
        />
        <a
          href="/portfolio/"
          class="reveal arrow-link shrink-0 inline-flex items-center gap-2 font-semibold text-accent-on-light hover:text-fg transition-colors"
        >
          Browse the full portfolio
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <ul class="grid grid-cols-2 lg:grid-cols-4 auto-rows-[150px] sm:auto-rows-[190px] gap-3 sm:gap-4">
        {previewPhotos.map((p, i) => {
          // 4+2+1+1+1+1+4+2 = 16 cells: the 4-wide grid closes with no hole.
          const spans = [
            'col-span-2 row-span-2',
            'row-span-2',
            '',
            '',
            '',
            '',
            'col-span-2 row-span-2',
            'col-span-2',
          ];
          return (
            <li class={`m-rise ${spans[i] ?? ''}`} style={`--i:${i}`}>
              <a href="/portfolio/" class="card-lift group relative block overflow-hidden rounded-media h-full">
                <Image
                  src={photoImage(p.id)}
                  alt={p.alt}
                  widths={[320, 480, 640, 900]}
                  sizes="(min-width:1024px) 25vw, 50vw"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                  format="webp"
                  quality={70}
                />
                <span class="absolute inset-0 bg-gradient-to-t from-scrim-media/55 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></span>
                <span class="absolute bottom-0 left-0 right-0 p-4 text-fg-on-media text-[13.5px] font-medium opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all">
                  {p.caption}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <WorkInProgress />

  <!-- WHY US + AREAS -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid lg:grid-cols-2 gap-14">
      <div>
        <SectionHeading
          eyebrow="About"
          title={c('home.why.title')}
        />
        <ul class="mt-8 space-y-5">
          {[
            {
              t: 'California licensed contractor',
              d: `We operate under ${c.site.license}, fully insured. You are protected, and the work is up to code.`,
            },
            {
              t: 'Transparent quotes',
              d: 'Your written estimate spells out materials, labor and timeline. The price we quote is the price you pay.',
            },
            {
              t: 'On-time completion',
              d: 'Flooring work disrupts your routine, so we plan carefully and finish when we said we would.',
            },
            {
              t: 'Prep work done properly',
              d: 'Old flooring out, subfloor levelled and cleaned, moisture checked. The part you never see is what keeps a floor flat.',
            },
          ].map((item) => (
            <li class="reveal flex gap-4">
              <span class="shrink-0 grid place-items-center size-9 rounded-btn bg-accent-wash text-accent-on-light mt-0.5" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <h3 class="font-semibold text-[17px] text-fg">{item.t}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-fg-muted">{item.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal rounded-card bg-surface-raised border border-hairline shadow-card p-7 sm:p-9 h-fit">
        <h3 class="font-display font-semibold text-2xl text-fg">{c('home.areas.title')}</h3>
        <p class="mt-2 text-[15px] text-fg-muted leading-relaxed">
          {c('home.areas.intro')}
        </p>
        <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2.5 text-[15px]">
          {CORE_CITIES.map((c) => (
            <li>
              <a
                href={`/service-areas/${c.slug}/`}
                class="inline-flex items-center gap-2 text-fg-body hover:text-accent-on-light transition-colors"
              >
                <span class="size-1 rounded-full bg-accent" aria-hidden="true"></span>
                {c.city}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[13.5px] text-fg-muted leading-relaxed">
          {alsoServing}
        </p>
        <a href="/service-areas/" class="mt-4 inline-flex items-center gap-1.5 font-semibold text-accent-on-light hover:text-fg transition-colors text-[15px]">
          All service areas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- REVIEWS TEASER: the star row and the rating claim only appear once real
       reviews exist in reviews.json. With none, we link out to Google instead
       of implying a rating we cannot show. -->
  <section class="relative isolate overflow-hidden py-20 sm:py-24 bg-surface-sunken">
    <!-- Harta ca fundal, nu ca widget: e decorativa, nu se poate atinge si nu
         primeste focus. Nu avem adresa de strada de la client, doar orasul,
         deci harta e centrata pe Sacramento in loc sa arate un pin inventat.
         Se incarca lazy, deci nu costa nimic pana cand sectiunea se apropie. -->
    <iframe
      class="absolute -z-10 border-0 pointer-events-none [filter:grayscale(1)_sepia(0.35)_saturate(0.65)_contrast(0.95)] -top-16 -left-16 -right-16 bottom-0 w-[calc(100%+8rem)] h-[calc(100%+4rem)]"
      src="https://www.google.com/maps?q=Sacramento,+CA&z=10&output=embed"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Map of the Sacramento area"
      aria-hidden="true"
      tabindex="-1"
    ></iframe>
    <div class="absolute inset-0 -z-10 bg-surface-sunken/72" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 text-center">
      {hasReviews && (
        <div class="reveal inline-flex items-center gap-2">
          <span class="flex items-center gap-1 text-accent-display" aria-hidden="true">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg width="22" height="22" viewBox="0 0 24 24" fill={i < Math.round(reviewSummary!.average) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z" />
              </svg>
            ))}
          </span>
          <span class="text-[16px] font-semibold text-fg">
            {reviewSummary!.average.toFixed(1)}
          </span>
          <span class="text-[15px] text-fg-muted">
            from {reviewSummary!.count} Google {reviewSummary!.count === 1 ? 'review' : 'reviews'}
          </span>
        </div>
      )}
      <h2 class="reveal mt-4 font-display font-semibold text-2xl sm:text-3xl text-fg">
        {hasReviews ? 'What customers say' : 'Reviews'}
      </h2>
      <p class="reveal mt-3 text-fg-muted max-w-lg mx-auto text-[16px]">
        {hasReviews
          ? 'Read what Sacramento homeowners think about working with us, straight from Google.'
          : 'Our reviews live on our Google Business Profile, along with photos from recent jobs around Sacramento.'}
      </p>
      <a
        href={hasReviews ? '/reviews' : c.site.googleProfile}
        target={hasReviews ? undefined : '_blank'}
        rel={hasReviews ? undefined : 'noopener'}
        class="reveal mt-6 inline-flex items-center gap-2 rounded-btn bg-control-dark hover:bg-control-dark-hover text-fg-on-dark font-semibold px-6 py-3 transition-colors"
      >
        {hasReviews ? 'Read our reviews' : 'See us on Google'}
      </a>
    </div>
  </section>

  <!-- FAQ PREVIEW -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <SectionHeading eyebrow="FAQ" title={c('home.faq.title')} align="center" />
      <div class="reveal mt-10">
        <FaqList items={faqPreview} withSchema={false} />
      </div>
      <p class="reveal mt-6 text-center">
        <a href="/faq/" class="font-semibold text-accent-on-light hover:text-fg transition-colors">
          See all questions
        </a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
