---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import faqData from '../data/faq.json';

const items = faqData as { q: string; a: string }[];
---

<Base
  title="FAQ | Flooring Questions Answered | Essential Flooring"
  description="Answers about estimates, timelines, dust, waterproof floors, preparation and more from Essential Flooring, Sacramento's licensed flooring contractor."
>
  <section class="pt-10 pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'FAQ' }]} />
      <div class="mt-8 mb-12">
        <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-fg">
          Questions, answered
        </h1>
        <p class="mt-5 text-[17px] leading-relaxed text-fg-muted">
          Everything homeowners usually ask before starting a flooring project.
          If your question is not here, call us at (916) 425-1361 and just ask.
        </p>
      </div>
      <FaqList items={items} />
    </div>
  </section>

  <CtaBand />
</Base>
