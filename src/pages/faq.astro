---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';

// Stock, not a job of ours: hands comparing flooring samples, which is what
// this page is about. Pexels #6583355 (Pexels License, commercial use, no
// attribution required); source and photographer in docs/PHOTO-CREDITS.md.
import faqSamples from '../assets/stock/faq-samples.jpg';
import faqData from '../data/faq.json';
import { getContent } from '../lib/content';

const c = await getContent();

const items = c.isEdited('faq.items')
  ? parseQA(c('faq.items'))
  : (faqData as { q: string; a: string }[]).map((i) => ({ q: c.apply(i.q), a: c.apply(i.a) }));

---

<Base
  title="FAQ | Flooring Questions Answered | Essential Flooring"
  description="Answers about estimates, timelines, dust, waterproof floors, preparation and more from Essential Flooring, Sacramento's licensed flooring contractor."
>
  <section class="pt-10 pb-16 sm:pb-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Breadcrumbs crumbs={[{ label: 'FAQ' }]} />

      <div class="mt-8 grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-14 items-center">
        <div class="max-w-xl">
          <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.1] tracking-tight text-fg">
            {c('faq.hero.title')}
          </h1>
          <p class="mt-5 text-[17px] leading-relaxed text-fg-muted">
            {c('faq.hero.intro')}
          </p>
          <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-[16px] text-fg-body">
            Not here?
            <a
              href={c.site.phoneHref}
              class="font-semibold text-accent-on-light underline underline-offset-4 decoration-2 hover:text-fg transition-colors"
            >
              Call {c.site.phone}
            </a>
            and just ask.
          </p>
        </div>

        <figure class="reveal lg:w-[420px] rounded-card bg-surface-raised p-2.5 shadow-card">
          <div class="parallax overflow-hidden rounded-media">
            <Image
              src={faqSamples}
              alt="Two people comparing oak and walnut flooring samples on a table"
              widths={[420, 840]}
              sizes="(min-width: 1024px) 420px, 100vw"
              class="parallax-img h-full w-full object-cover aspect-[4/3]"
              loading="eager"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <FaqList items={items} />
    </div>
  </section>

  <CtaBand />
</Base>
