---
import '@fontsource-variable/inter';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickContact from '../components/QuickContact.astro';
import { SITE, AREA_SERVED } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  schema?: object[];
}

const {
  title, description, ogImage, ogType = 'website',
  ogImageAlt = 'Essential Flooring, licensed Sacramento flooring contractor, CSLB #1117565',
  noindex = false, schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage ?? '/og-default.jpg', Astro.site);
// The business entity keeps one stable image. Without this, a blog post cover
// would redefine the image of the same @id on every article.
const businessImage = new URL('/og-default.jpg', Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE.domain}/#business`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: `${SITE.domain}/`,
  telephone: SITE.phoneSchema,
  email: SITE.email,
  image: businessImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: AREA_SERVED,
  sameAs: [SITE.instagram, SITE.facebook, SITE.googleProfile],
  openingHours: SITE.hoursSchema,
  foundingDate: String(SITE.founded),
  founder: { '@type': 'Person', name: SITE.founder },
  knowsAbout: [
    'Hardwood floor refinishing', 'Hardwood installation', 'LVP flooring installation',
    'Laminate flooring installation', 'Tile installation', 'Carpet installation',
    'Stair installation and refinishing',
  ],
};

const schemas = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Browsers do not resolve CSS variables here, so this one hex stays literal.
        Update it alongside --ef-surface-dark when the direction is chosen. */}
    <meta name="theme-color" content="#efece4" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-control-dark focus:text-fg-on-dark focus:px-4 focus:py-2 focus:rounded-md"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <QuickContact />

    <script>
      // Reveal on scroll (failsafe: visible by default without JS)
      const els = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
        // Failsafe: anything still hidden after 2.5s becomes visible
        setTimeout(() => els.forEach((el) => el.classList.add('is-visible')), 2500);
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Lightweight first-party analytics -> Supabase (no cookies, no PII).
      import { trackPageView } from '../lib/analytics';
      trackPageView();
    </script>

    <script>
      // Fluid, macOS-like scrolling on desktop pointers only. Phones keep
      // native scrolling, which is smoother and cheaper on old devices.
      import Lenis from 'lenis';
      const fine = window.matchMedia('(pointer: fine)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !reduced) {
        document.documentElement.style.scrollBehavior = 'auto';
        const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        // Anchor links go through Lenis so they glide instead of jumping.
        document.addEventListener('click', (e) => {
          // The skip link must stay native so focus actually moves into <main>.
          const a = (e.target as HTMLElement).closest('a[href^="#"]:not([href="#main"])');
          if (!a) return;
          const id = a.getAttribute('href')!.slice(1);
          const el = id && document.getElementById(id);
          if (el) {
            e.preventDefault();
            lenis.scrollTo(el, { offset: -90 });
          }
        });
      }
    </script>
  </body>
</html>
