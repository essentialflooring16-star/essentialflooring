# ── Supabase ──────────────────────────────────────────────────────────────
# Cabinetul de admin, analytics, portofoliu dinamic si blog.
# Valorile din Settings > API in proiectul de pe supabase.com.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role. NUMAI pe Vercel, niciodata in browser: cu ea functia
# api/contact salveaza cererea inainte sa incerce emailul, si tot ea face
# rate limiting. Fara ea formularul merge, dar pierde plasa de siguranta.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (emailul din formularul de contact) ────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=essentialflooring16@gmail.com
CONTACT_FROM_EMAIL=Essential Flooring <onboarding@resend.dev>
