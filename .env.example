# Supabase (cabinetul de admin + analytics + portofoliu dinamic)
# Creezi proiectul pe supabase.com, apoi copiezi valorile din Settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

